                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Returns all buildings for an app"
        },
        {
          "info": {
            "name": "Creates a building",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/insights/v0/buildings",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.measurabl.com/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Create a new building record. The response will include the created building record, including its ID.\n\nThe request body can include building information in one of two formats:\n- Coordinates and additional building information (latitude, longitude, primaryPropertyType, yearBuilt, grossFloorArea, grossFloorAreaUnits, buildingCustomId, buildingClientMetadata)\n- Full address and additional building information (addressLine1, addressLine2, city, stateOrProvince, postalCode, country, primaryPropertyT"
        },
        {
          "info": {
            "name": "Requests a CSV download for the current app",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/insights/v0/buildings/export",
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.measurabl.com/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Requests a CSV download for the current app"
        }
      ]
    },

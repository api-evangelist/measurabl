      "items": [
        {
          "info": {
            "name": "Downloads the export file",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/insights/v0/listed_real_estate_reports/:id/building_level/:data_set/download",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Example: <em>august-2023</em>"
              },
              {
                "name": "data_set",
                "value": "",
                "type": "path",
                "description": "Example: <em>t-12-carbon-estimates</em>"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.measurabl.com/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Provides a redirect to download the export file.\nThe url in the redirect has an expiration, typically of 5 minutes.\n"
        },
        {
